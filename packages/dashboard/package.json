{
  "name": "@yachaydeep/dashboard",
  "version": "0.1.0",
  "description": "Yachay Deep — la cara del sistema de analítica: componentes React/ECharts (tableros y redes estilo VOSviewer).",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external react,echarts,echarts-for-react,zustand,@tanstack/react-query",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "echarts": ">=5.4",
    "echarts-for-react": ">=3.0",
    "zustand": ">=4",
    "@tanstack/react-query": ">=5"
  },
  "dependencies": {
    "@yachaydeep/analytics-contract": "*"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "echarts": "^5.5.0",
    "echarts-for-react": "^3.0.2",
    "zustand": "^4.5.0",
    "@tanstack/react-query": "^5.51.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
